# ==============================================================================
# AutoReiv Environment Configuration [.env.example]
# Copy to .env and adjust variables as needed. Do NOT commit .env or API keys.
# ==============================================================================

# --- Server & Network ---
HOST=0.0.0.0
PORT=8000

# --- User Data & Storage ---
# User data directory (db, wiki, packs, settings).
# Defaults: %LOCALAPPDATA%\AutoReiv (Windows), ~/.autoreiv (Linux/macOS), /data (Docker)
AUTOREIV_DATA_DIR=

# Optional explicit path overrides (leave unset to use AUTOREIV_DATA_DIR defaults)
# AUTOREIV_DB_PATH=
# AUTOREIV_WIKI_PATH=

# ==============================================================================
# LLM Providers (Configure one or more)
# ==============================================================================

# --- 1. Ollama (Local / LAN) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# --- 2. LM Studio (Local / LAN) ---
# LMSTUDIO_HOST=http://127.0.0.1:1234/v1
# LMSTUDIO_API_KEY=

# --- 3. vLLM (Self-Hosted) ---
# VLLM_HOST=http://127.0.0.1:8000/v1
# VLLM_API_KEY=

# --- 4. Google Gemini ---
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- 5. Anthropic Claude ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- 6. OpenAI ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- 7. OpenRouter ---
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- 8. Groq Cloud ---
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- 9. DeepSeek ---
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- 10. Together AI ---
# TOGETHER_API_KEY=
# TOGETHER_BASE_URL=https://api.together.xyz/v1

# ==============================================================================
# Gateway & Reliability Settings
# ==============================================================================
GATEWAY_DEFAULT_TIMEOUT_SECONDS=180.0
