# ==============================================================================
# AutoReiv Environment Configuration [.env.example]
# Copy to .env and adjust variables as needed
# ==============================================================================

# Server & Network Configuration
HOST=0.0.0.0
PORT=8000

# User data directory (db, wiki, skills). Default: %LOCALAPPDATA%\AutoReiv (Windows), ~/.autoreiv (POSIX), /data (Docker)
AUTOREIV_DATA_DIR=

# Optional explicit overrides (unset to derive from AUTOREIV_DATA_DIR)
# AUTOREIV_DB_PATH=
# AUTOREIV_WIKI_PATH=

# Local Ollama Provider (Nimo Mini PC 2L or Local Host)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional Cloud OpenAI Provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Gateway Timeout in Seconds
GATEWAY_DEFAULT_TIMEOUT_SECONDS=60.0
