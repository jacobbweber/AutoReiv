{
  "name": "autoreiv-web",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:frontend": "eslint src/web/static tests/unit/frontend tests/e2e",
    "lint:frontend:fix": "eslint src/web/static tests/unit/frontend tests/e2e --fix",
    "format:frontend": "prettier --write \"src/web/static/**/*.{js,css}\" \"tests/**/*.{js,ts}\"",
    "test:unit:frontend": "vitest run",
