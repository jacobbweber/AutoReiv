    "preflight": "python .agents/skills/rtm-sync/scripts/preflight.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "vitest": "^2.1.0"
  }
}
